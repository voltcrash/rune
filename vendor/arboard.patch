+	#[cfg(target_os = "linux")]
+	pub(crate) fn set_x11_text_with_owner(&mut self, kind: LinuxClipboardKind, text: &str, owner: std::sync::Arc<()>) -> Result<bool, Error> {
+		match self {
+			Self::X11(clipboard) => {
+				clipboard.set_text_with_owner(text.into(), kind, WaitConfig::None, false, Some(owner))?;
+				Ok(true)
+			}
+			#[cfg(feature = "wayland-data-control")]
+			Self::WlDataControl(_) => Ok(false),
+		}
+	}
